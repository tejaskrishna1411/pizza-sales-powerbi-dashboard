              "expression": "let\n    Source = stg_pizza_sales,\n    CategoryOnly = Table.SelectColumns(Source, {\"pizza_category\"}),\n    DistinctCategory = Table.Distinct(CategoryOnly),\n    Sorted = Table.Sort(DistinctCategory, {{\"pizza_category\", Order.Ascending}})\nin\n    Sorted"
            }
          }
        ]
      },
