            "summarizeBy": "none",
            "lineageTag": "f3b4d8ab-b887-475e-97c8-69754e979da5"
          }
        ],
        "partitions": [
          {
            "name": "DimPizza",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = stg_pizza_sales,\n    PizzaCols = Table.SelectColumns(Source, {\"pizza_name_id\", \"pizza_name\", \"pizza_category\", \"pizza_ingredients\"}),\n    DistinctPizza = Table.Distinct(PizzaCols, {\"pizza_name_id\"}),\n    Sorted = Table.Sort(DistinctPizza, {{\"pizza_name_id\", Order.Ascending}})\nin\n    Sorted"
            }
          }
        ]
      },
      {
        "name": "DimSize",
        "lineageTag": "5cd52dcb-1782-4dee-9177-4384d52d8d45",
        "columns": [
          {
            "name": "pizza_size",
            "dataType": "string",
            "sourceColumn": "pizza_size",
            "sortByColumn": "size_sort",
            "summarizeBy": "none",
            "lineageTag": "c49e3706-78fe-46e2-add1-55487d9630ca"
          },
          {
            "name": "size_sort",
            "dataType": "int64",
            "sourceColumn": "size_sort",
            "isHidden": true,
            "summarizeBy": "none",
            "lineageTag": "00aefd95-bade-4358-8c63-22a7c9a22ea5"
          }
        ],
        "partitions": [
          {
            "name": "DimSize",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = stg_pizza_sales,\n    SizeOnly = Table.SelectColumns(Source, {\"pizza_size\"}),\n    DistinctSize = Table.Distinct(SizeOnly),\n    AddSortKey = Table.AddColumn(DistinctSize, \"size_sort\", each if [pizza_size] = \"S\" then 1 else if [pizza_size] = \"M\" then 2 else if [pizza_size] = \"L\" then 3 else if [pizza_size] = \"XL\" then 4 else if [pizza_size] = \"XXL\" then 5 else 99, Int64.Type),\n    Sorted = Table.Sort(AddSortKey, {{\"size_sort\", Order.Ascending}})\nin\n    Sorted"
            }
          }
        ]
      },
      {
        "name": "DimCategory",
        "lineageTag": "bf42959d-c727-447c-a155-f9f272e81d2e",
