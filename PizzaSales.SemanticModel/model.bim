    "expressions": [
      {
        "name": "stg_pizza_sales",
        "kind": "m",
        "expression": "let\n    Source = Excel.Workbook(File.Contents(\"C:\\Users\\gmtej\\OneDrive\\Desktop\\projects\\Data Analyst Project - SQL+PowerBI+Excel\\pizza_sales_excel_file.xlsx\"), null, true),\n    RawSheet = Source{[Item=\"pizza_sales\",Kind=\"Sheet\"]}[Data],\n    PromotedHeaders = Table.PromoteHeaders(RawSheet, [PromoteAllScalars=true]),\n    // 1. Correct data types (order_time is Time, not DateTime)\n    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {{\"pizza_id\", Int64.Type}, {\"order_id\", Int64.Type}, {\"pizza_name_id\", type text}, {\"quantity\", Int64.Type}, {\"order_date\", type date}, {\"order_time\", type time}, {\"unit_price\", type number}, {\"total_price\", type number}, {\"pizza_size\", type text}, {\"pizza_category\", type text}, {\"pizza_ingredients\", type text}, {\"pizza_name\", type text}}),\n    // 2. Trim and clean free-text columns\n    CleanedText = Table.TransformColumns(ChangedTypes, {{\"pizza_name_id\", each Text.Trim(Text.Clean(_)), type text}, {\"pizza_name\", each Text.Trim(Text.Clean(_)), type text}, {\"pizza_ingredients\", each Text.Trim(Text.Clean(_)), type text}}),\n    // 3. Standardise size (upper case) and category (proper case)\n    Standardised = Table.TransformColumns(CleanedText, {{\"pizza_size\", each Text.Upper(Text.Trim(Text.Clean(_))), type text}, {\"pizza_category\", each Text.Proper(Text.Trim(Text.Clean(_))), type text}}),\n    // 4. Remove exact duplicate rows only\n    RemovedDuplicates = Table.Distinct(Standardised)\nin\n    RemovedDuplicates",
        "lineageTag": "a167fea5-5a4b-4797-adac-ec4f5657839c",
        "description": "Staging query (load disabled): types, trim/clean, standardise size and category, remove exact duplicates."
      }
    ]
  }
}