        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM ( FactPizzaSales[total_price] )",
            "displayFolder": "1 Sales KPIs",
            "lineageTag": "a261fdff-2905-4443-9754-95ea5ed47c64",
            "formatString": "$#,##0",
            "description": "Sum of total_price."
          },
          {
            "name": "Total Orders",
            "expression": "DISTINCTCOUNT ( FactPizzaSales[order_id] )",
            "displayFolder": "1 Sales KPIs",
            "lineageTag": "d864659d-612f-4f8b-9f56-5308ea7f359d",
            "formatString": "#,##0",
            "description": "Distinct count of order_id."
          },
          {
            "name": "Total Pizzas Sold",
            "expression": "SUM ( FactPizzaSales[quantity] )",
            "displayFolder": "1 Sales KPIs",
            "lineageTag": "4b8878fd-36c2-4a42-8e6b-c3fdf0b4c2e0",
            "formatString": "#,##0",
            "description": "Sum of quantity."
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE ( [Total Revenue], [Total Orders] )",
            "displayFolder": "1 Sales KPIs",
            "lineageTag": "2b1b5b83-fdbd-4ec0-958a-0b768475fb8b",
            "formatString": "$#,##0.00",
            "description": "Total Revenue / Total Orders."
          },
          {
            "name": "Average Pizza Price",
            "expression": "AVERAGE ( FactPizzaSales[unit_price] )",
            "displayFolder": "1 Sales KPIs",
            "lineageTag": "f86690ce-99fc-4317-927b-b153956f84da",
            "formatString": "$#,##0.00",
            "description": "Average unit price of lines sold."
          },
          {
            "name": "Average Pizzas Per Order",
            "expression": "DIVIDE ( [Total Pizzas Sold], [Total Orders] )",
            "displayFolder": "1 Sales KPIs",
            "lineageTag": "35be6956-d923-4a7a-bf9a-7809287795e5",
            "formatString": "0.00",
            "description": "Total Pizzas Sold / Total Orders."
          },
          {
            "name": "Revenue Per Pizza",
            "expression": "DIVIDE ( [Total Revenue], [Total Pizzas Sold] )",
            "displayFolder": "1 Sales KPIs",
            "lineageTag": "5b0eebae-6f50-4260-8626-524d4316b900",
            "formatString": "$#,##0.00",
            "description": "Realised revenue per pizza."
          },
          {
            "name": "Revenue Previous Month",
            "expression": "CALCULATE ( [Total Revenue], DATEADD ( DimDate[Date], -1, MONTH ) )",
            "displayFolder": "2 Time Intelligence",
            "lineageTag": "3959bf9f-1ec9-4600-9dc2-eef15cef3bf7",
            "formatString": "$#,##0"
          },
          {
            "name": "Revenue Previous Year",
            "expression": "CALCULATE ( [Total Revenue], SAMEPERIODLASTYEAR ( DimDate[Date] ) )",
            "displayFolder": "2 Time Intelligence",
            "lineageTag": "0a552da5-b4af-495f-a035-b6d08fe97674",
            "formatString": "$#,##0",
            "description": "Blank here: data covers one year (2015)."
          },
          {
            "name": "Revenue Growth %",
            "expression": "VAR CurrentRevenue = [Total Revenue]\nVAR PreviousRevenue = [Revenue Previous Month]\nRETURN\n    IF ( NOT ISBLANK ( PreviousRevenue ), DIVIDE ( CurrentRevenue - PreviousRevenue, PreviousRevenue ) )",
            "displayFolder": "2 Time Intelligence",
            "lineageTag": "35aee45c-3c50-4654-bd3c-d98771b6fb8e",
            "formatString": "0.0%",
            "description": "Month-over-month growth."
          },
          {
            "name": "Revenue YoY Growth %",
            "expression": "VAR CurrentRevenue = [Total Revenue]\nVAR PreviousRevenue = [Revenue Previous Year]\nRETURN\n    IF ( NOT ISBLANK ( PreviousRevenue ), DIVIDE ( CurrentRevenue - PreviousRevenue, PreviousRevenue ) )",
            "displayFolder": "2 Time Intelligence",
            "lineageTag": "6dfed478-966d-4ae7-b114-23051c2d4e90",
            "formatString": "0.0%",
            "description": "Blank until 2+ years of data."
          },
          {
            "name": "Monthly Revenue",
            "expression": "CALCULATE ( [Total Revenue], ALLEXCEPT ( DimDate, DimDate[Year], DimDate[Quarter], DimDate[Month Number], DimDate[Month Name], DimDate[Year-Month] ) )",
            "displayFolder": "2 Time Intelligence",
            "lineageTag": "0bbab977-62ab-42fb-82dc-d36c32574cb2",
            "formatString": "$#,##0",
            "description": "Whole-month revenue ignoring day filters."
          },
          {
            "name": "Yearly Revenue",
            "expression": "CALCULATE ( [Total Revenue], ALLEXCEPT ( DimDate, DimDate[Year] ) )",
            "displayFolder": "2 Time Intelligence",
            "lineageTag": "d554a17d-cdbd-4bd3-ab00-636ecf736995",
            "formatString": "$#,##0",
            "description": "Whole-year revenue."
          },
          {
            "name": "Cumulative Revenue",
            "expression": "VAR LastDateInContext = MAX ( DimDate[Date] )\nRETURN\n    CALCULATE ( [Total Revenue], FILTER ( ALLSELECTED ( DimDate[Date] ), DimDate[Date] <= LastDateInContext ) )",
            "displayFolder": "2 Time Intelligence",
            "lineageTag": "e729c0cf-467a-4534-975d-9d851eba376d",
            "formatString": "$#,##0",
            "description": "Running total over the selected range."
          },
          {
            "name": "YTD Revenue",
            "expression": "TOTALYTD ( [Total Revenue], DimDate[Date] )",
            "displayFolder": "2 Time Intelligence",
            "lineageTag": "575cb3e2-054e-4218-8116-2b45b44be9c5",
            "formatString": "$#,##0"
          },
          {
            "name": "MTD Revenue",
            "expression": "TOTALMTD ( [Total Revenue], DimDate[Date] )",
            "displayFolder": "2 Time Intelligence",
            "lineageTag": "62cc1c15-0107-4549-9ac1-29dd79b14a9b",
            "formatString": "$#,##0"
          },
          {
            "name": "Best Selling Pizza",
            "expression": "VAR X = FILTER ( ADDCOLUMNS ( VALUES ( DimPizza[pizza_name] ), \"@V\", [Total Pizzas Sold] ), NOT ISBLANK ( [@V] ) )\nRETURN\n    CONCATENATEX ( TOPN ( 1, X, [@V], DESC ), DimPizza[pizza_name], \", \" )",
            "displayFolder": "3 Product Analytics",
            "lineageTag": "7a84de12-7574-4ded-b804-3afe5d094c07",
            "description": "Highest quantity sold."
          },
          {
            "name": "Worst Selling Pizza",
            "expression": "VAR X = FILTER ( ADDCOLUMNS ( VALUES ( DimPizza[pizza_name] ), \"@V\", [Total Pizzas Sold] ), NOT ISBLANK ( [@V] ) )\nRETURN\n    CONCATENATEX ( TOPN ( 1, X, [@V], ASC ), DimPizza[pizza_name], \", \" )",
            "displayFolder": "3 Product Analytics",
            "lineageTag": "ce58fa80-cb89-4aac-b28a-078ec2e44978",
            "description": "Lowest quantity sold."
          },
          {
            "name": "Top Pizza by Revenue",
            "expression": "VAR X = FILTER ( ADDCOLUMNS ( VALUES ( DimPizza[pizza_name] ), \"@V\", [Total Revenue] ), NOT ISBLANK ( [@V] ) )\nRETURN\n    CONCATENATEX ( TOPN ( 1, X, [@V], DESC ), DimPizza[pizza_name], \", \" )",
            "displayFolder": "3 Product Analytics",
            "lineageTag": "97de24b8-d96f-47c5-aa95-e49551c7dd1f"
          },
          {
            "name": "Best Pizza Category",
            "expression": "VAR X = FILTER ( ADDCOLUMNS ( VALUES ( DimCategory[pizza_category] ), \"@V\", [Total Revenue] ), NOT ISBLANK ( [@V] ) )\nRETURN\n    CONCATENATEX ( TOPN ( 1, X, [@V], DESC ), DimCategory[pizza_category], \", \" )",
            "displayFolder": "3 Product Analytics",
            "lineageTag": "e922bb48-7cf7-40ae-8a1c-9089f5f51f95",
            "description": "Category with the highest revenue."
          },
          {
            "name": "Average Items Per Order",
            "expression": "DIVIDE ( COUNTROWS ( FactPizzaSales ), [Total Orders] )",
            "displayFolder": "4 Order Analytics",
            "lineageTag": "de7d72c2-3869-43e4-8ed4-70b7a1421549",
            "formatString": "0.00",
            "description": "Line items per order."
          },
          {
            "name": "Orders Per Day",
            "expression": "DIVIDE ( [Total Orders], DISTINCTCOUNT ( FactPizzaSales[order_date] ) )",
            "displayFolder": "4 Order Analytics",
            "lineageTag": "e5800f7e-fa6a-4229-8007-c364d20cdf5e",
            "formatString": "#,##0.0",
            "description": "Orders per trading day."
          },
          {
            "name": "Revenue Per Order",
            "expression": "[Average Order Value]",
            "displayFolder": "4 Order Analytics",
            "lineageTag": "355bf18d-b62c-4757-9e48-9cd0a228a8ae",
            "formatString": "$#,##0.00"
          },
          {
            "name": "Peak Order Hour",
            "expression": "VAR HourOrders = ADDCOLUMNS ( VALUES ( FactPizzaSales[Order Hour] ), \"@Orders\", [Total Orders] )\nRETURN\n    MAXX ( TOPN ( 1, HourOrders, [@Orders], DESC ), FactPizzaSales[Order Hour] )",
            "displayFolder": "4 Order Analytics",
            "lineageTag": "8f43b221-0039-4624-8eef-2bf21b11ca73",
            "formatString": "00\":00\"",
            "description": "Hour with the most orders."
          },
          {
            "name": "Peak Order Day",
            "expression": "VAR DayOrders = ADDCOLUMNS ( VALUES ( DimDate[Day Name] ), \"@Orders\", [Total Orders] )\nRETURN\n    CONCATENATEX ( TOPN ( 1, DayOrders, [@Orders], DESC ), DimDate[Day Name], \", \" )",
            "displayFolder": "4 Order Analytics",
            "lineageTag": "1f81795a-66a5-440e-b457-38dd93bb65c0",
            "description": "Weekday with the most orders."
          },
          {
            "name": "Revenue Contribution %",
            "expression": "DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALLSELECTED () ) )",
            "displayFolder": "5 Contribution",
            "lineageTag": "6f5f88b5-7d9c-4c40-8fba-a0dba2e38738",
            "formatString": "0.0%",
            "description": "Share of revenue in the current selection."
          },
          {
            "name": "Pizza Quantity Contribution %",
            "expression": "DIVIDE ( [Total Pizzas Sold], CALCULATE ( [Total Pizzas Sold], ALLSELECTED () ) )",
            "displayFolder": "5 Contribution",
            "lineageTag": "12333704-34ee-4075-9375-c8bbad7353df",
            "formatString": "0.0%"
          },
          {
            "name": "Category Contribution %",
            "expression": "DIVIDE ( [Total Revenue], CALCULATE ( [Total Revenue], ALLSELECTED ( DimCategory ) ) )",
            "displayFolder": "5 Contribution",
            "lineageTag": "2949bacc-b7ad-42fd-a16c-ea9ed829630f",
            "formatString": "0.0%"
          },
          {
            "name": "Top 10 Pizzas Revenue %",
            "expression": "VAR Top10 = TOPN ( 10, ALLSELECTED ( DimPizza[pizza_name] ), [Total Revenue], DESC )\nVAR Top10Revenue = SUMX ( Top10, [Total Revenue] )\nRETURN\n    DIVIDE ( Top10Revenue, CALCULATE ( [Total Revenue], ALLSELECTED () ) )",
            "displayFolder": "5 Contribution",
            "lineageTag": "14b7b2df-8699-4228-b9ef-e04047fae0d0",
            "formatString": "0.0%",
            "description": "Revenue share of the top 10 pizzas."
          },
          {
            "name": "TopN Value",
            "expression": "SELECTEDVALUE ( 'TopN Selector'[Value], 10 )",
            "displayFolder": "6 Ranking",
            "lineageTag": "7b9e1326-7044-4c12-b079-5f3387abbde0",
            "formatString": "0",
            "description": "Number chosen in the Top N slicer (default 10)."
          },
          {
            "name": "Pizza Rank by Revenue",
            "expression": "RANKX ( ALLSELECTED ( DimPizza[pizza_name] ), [Total Revenue], , DESC, DENSE )",
            "displayFolder": "6 Ranking",
            "lineageTag": "913e19f5-476d-4688-a9ec-d33754569741",
            "formatString": "0"
          },
          {
            "name": "Pizza Rank by Quantity",
            "expression": "RANKX ( ALLSELECTED ( DimPizza[pizza_name] ), [Total Pizzas Sold], , DESC, DENSE )",
            "displayFolder": "6 Ranking",
            "lineageTag": "55efe115-7946-446c-b6c9-1634797d62f0",
            "formatString": "0"
          },
          {
            "name": "Show In Top N",
            "expression": "IF ( [Pizza Rank by Revenue] <= [TopN Value], 1, 0 )",
            "displayFolder": "6 Ranking",
            "lineageTag": "edbb3c93-2d9c-45a0-bda6-3607303ca73d",
            "formatString": "0",
            "description": "Visual filter flag (=1): Top N by revenue."
          },
          {
            "name": "Show In Top N (Qty)",
            "expression": "IF ( [Pizza Rank by Quantity] <= [TopN Value], 1, 0 )",
            "displayFolder": "6 Ranking",
            "lineageTag": "ee6841e5-d03b-4f99-a346-95d2125b23e3",
            "formatString": "0",
            "description": "Visual filter flag (=1): Top N by quantity."
          },
          {
            "name": "Show In Bottom N",
            "expression": "VAR TotalPizzas = COUNTROWS ( ALLSELECTED ( DimPizza[pizza_name] ) )\nRETURN IF ( [Pizza Rank by Revenue] > TotalPizzas - [TopN Value], 1, 0 )",
            "displayFolder": "6 Ranking",
            "lineageTag": "7a6746a7-d504-4e62-9e94-e55eb37808dd",
            "formatString": "0",
            "description": "Visual filter flag (=1): Bottom N by revenue."
          },
          {
            "name": "DQ Row Count",
            "expression": "COUNTROWS ( FactPizzaSales )",
            "displayFolder": "7 Data Quality",
            "lineageTag": "c4a865c2-0482-4636-a5ea-1a2c0da1175c",
            "formatString": "#,##0"
          },
          {
            "name": "DQ Price Mismatch Rows",
            "expression": "COALESCE ( COUNTROWS ( FILTER ( FactPizzaSales, ABS ( FactPizzaSales[quantity] * FactPizzaSales[unit_price] - FactPizzaSales[total_price] ) > 0.01 ) ), 0 )",
            "displayFolder": "7 Data Quality",
            "lineageTag": "832cc78f-c39a-4d3d-af53-d24b52cb10f9",
            "formatString": "#,##0",
            "description": "Rows where quantity x unit_price differs from total_price."
          },
          {
            "name": "DQ Invalid Qty or Price Rows",
            "expression": "COALESCE ( COUNTROWS ( FILTER ( FactPizzaSales, FactPizzaSales[quantity] <= 0 || FactPizzaSales[unit_price] <= 0 || FactPizzaSales[total_price] <= 0 ) ), 0 )",
            "displayFolder": "7 Data Quality",
            "lineageTag": "294034e0-00eb-426d-91f4-2bd1b0c86c6c",
            "formatString": "#,##0"
          },
          {
            "name": "DQ Duplicate Pizza IDs",
            "expression": "COUNTROWS ( FactPizzaSales ) - DISTINCTCOUNT ( FactPizzaSales[pizza_id] )",
            "displayFolder": "7 Data Quality",
            "lineageTag": "17c82bfd-ef00-44fa-a0c7-bcdbf6ed3fed",
            "formatString": "#,##0"
          }
        ]
      },
